{
  "name": "@keepling/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Keepling for Mac",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:utility-preload && pnpm run build:renderer && pnpm run build:worker",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:utility-preload": "vite build --config vite.utility-preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:worker": "vite build --config vite.worker.config.ts",
    "build:harness": "vite build --config vite.harness.config.ts",
    "dev": "vite --config vite.renderer.config.ts",
    "package": "node ../../tooling/package-desktop.mjs",
    "smoke:packaged": "node ../../tooling/smoke-desktop-packaged.mjs",
    "test": "vitest run --config vitest.config.ts --project application --project renderer --project store --project worker --project performance",
    "test:e2e": "playwright test --config playwright.config.ts --project electron",
    "test:ipc": "vitest run --config vitest.config.ts --project ipc",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "44.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  }
}
