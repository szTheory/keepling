{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keepling.dev/contracts/sync-state-machine.schema.json",
  "title": "Keepling synchronization state-machine vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fixed_clock", "cases"],
  "properties": {
    "version": {"const": 1},
    "fixed_clock": {"type": "string", "format": "date-time"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "actions"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "actions": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        }
      }
    }
  }
}
