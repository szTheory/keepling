# Keepling credentialed infrastructure commands require references, never
# plaintext credentials. Populate an ignored local environment through a
# password-manager launcher; keep every referenced secret file outside Git.
HCLOUD_TOKEN=<password-manager-reference>
TOFU_BIN=<absolute-path-to-verified-opentofu-1.12.6>
KEEPLING_SSH_PUBLIC_KEY_FILE=<absolute-path-to-public-key>
KEEPLING_BACKUP_PRIMARY_CREDENTIAL_FILE=<absolute-path-to-private-json>
KEEPLING_BACKUP_MIRROR_CREDENTIAL_FILE=<absolute-path-to-private-json>
KEEPLING_BACKUP_CIPHER_FILE=<absolute-path-to-private-file>
# Use a separately scoped state credential when provisioning. Do not reuse the
# recovery-mirror credential for mutable OpenTofu state.
KEEPLING_TOFU_STATE_CREDENTIAL_FILE=<absolute-path-to-private-json>
CLOUDFLARE_API_TOKEN_FILE=<absolute-path-to-private-file>
KEEPLING_DNS_ZONE_ID=<password-manager-reference>
KEEPLING_DNS_RECORD_NAME=<password-manager-reference>
