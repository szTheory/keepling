# Copy this file to ~/.config/keepling/phase-2/env.sh, fill in only absolute
# paths, then have the repository-local (ignored) .envrc source that file.
# This file intentionally contains no credentials or provider identifiers.
export KEEPLING_HETZNER_CREDENTIAL_FILE="$HOME/.config/keepling/phase-2/hetzner.json"
export KEEPLING_CLOUDFLARE_DNS_CREDENTIAL_FILE="$HOME/.config/keepling/phase-2/cloudflare-dns.json"
export KEEPLING_BACKUP_PRIMARY_CREDENTIAL_FILE="$HOME/.config/keepling/phase-2/b2-primary.json"
export KEEPLING_BACKUP_MIRROR_CREDENTIAL_FILE="$HOME/.config/keepling/phase-2/r2-mirror.json"
export KEEPLING_TOFU_STATE_CREDENTIAL_FILE="$HOME/.config/keepling/phase-2/b2-tofu-state.json"
export KEEPLING_SSH_PUBLIC_KEY_FILE="$HOME/.config/keepling/phase-2/replacement-run.pub"
export KEEPLING_BACKUP_CIPHER_FILE="$HOME/.config/keepling/phase-2/backup-cipher.key"

# Non-secret local toolchain locations. Leave unset to use PATH where possible.
export TOFU_BIN="$HOME/.asdf/shims/tofu"
export CLOUD_INIT_SCHEMA_BIN="$HOME/.local/bin/keepling-cloud-init-schema"
export CLOUD_INIT_SCHEMA_VERSION="26.1"
export HCLOUD_PROVIDER_PLUGIN_DIR="$HOME/.local/share/keepling-tofu-providers"
