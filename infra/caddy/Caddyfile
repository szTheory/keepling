{
	admin off
	auto_https disable_redirects
}

(keepling_proxy) {
	log {
		output stdout
		format json
	}

	reverse_proxy app:4000 {
		header_up X-Forwarded-Proto https
	}

	handle_errors {
		header Retry-After "2"
		respond "Keepling is briefly unavailable; retry the exact request.\n" 503
	}
}

:80 {
	import keepling_proxy
}

https://{$KEEPLING_HOST:localhost} {
	import keepling_proxy
}
