{
  "name": "keepling",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:web": "pnpm --filter @keepling/web build",
    "contracts:check": "node tooling/check-contracts.mjs",
    "contracts:generate": "openapi-typescript packages/contracts/openapi/keepling.yaml --output packages/contracts/generated/keepling.ts --alphabetize --immutable",
    "dev:web": "pnpm --filter @keepling/web dev",
    "lint:web": "pnpm --filter @keepling/web lint",
    "stack:local": "./tooling/run-local-stack.sh --start",
    "test:phase-1": "./tooling/test-phase-1.sh --run",
    "typecheck:web": "pnpm --filter @keepling/web typecheck"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
