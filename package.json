{
  "name": "keepling",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:web": "pnpm --filter @keepling/web build",
    "contracts:check": "node tooling/check-contracts.mjs",
    "contracts:generate": "openapi-typescript packages/contracts/openapi/keepling.yaml --output packages/contracts/generated/keepling.ts --alphabetize --immutable",
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "dev:web": "pnpm --filter @keepling/web dev",
    "generate:ios:client": "node tooling/generate-ios-client.mjs",
    "lint:web": "pnpm --filter @keepling/web lint",
    "package:desktop": "pnpm --dir apps/desktop package",
    "smoke:desktop:packaged": "pnpm --dir apps/desktop smoke:packaged",
    "stack:local": "./tooling/run-local-stack.sh --start",
    "test:changed": "node tooling/select-tests.mjs",
    "test:desktop": "pnpm --dir apps/desktop test",
    "test:desktop:changed": "node tooling/test-changed.mjs",
    "test:desktop:e2e": "pnpm --dir apps/desktop test:e2e",
    "test:desktop:ipc": "pnpm --dir apps/desktop test:ipc",
    "test:phase-1": "./tooling/test-phase-1.sh --run",
    "typecheck:desktop": "pnpm --dir apps/desktop typecheck",
    "typecheck:web": "pnpm --filter @keepling/web typecheck",
    "verify:desktop:real-stack": "node tooling/verify-real-stack-desktop.mjs",
    "verify:ios:phase": "node tooling/verify-ios-phase.mjs",
    "verify:desktop:reproducible": "node tooling/verify-package-reproducibility.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
