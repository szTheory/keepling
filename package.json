{
  "name": "keepling",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:ios:signed": "node tooling/build-ios-signed.mjs",
    "build:web": "pnpm --filter @keepling/web build",
    "contracts:check": "node tooling/check-contracts.mjs && pnpm run contracts:check:mcp",
    "contracts:check:mcp": "node tooling/generate-mcp-tool-schemas.mjs --check",
    "contracts:generate": "openapi-typescript packages/contracts/openapi/keepling.yaml --output packages/contracts/generated/keepling.ts --alphabetize --immutable",
    "contracts:generate:mcp": "node tooling/generate-mcp-tool-schemas.mjs",
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "dev:web": "pnpm --filter @keepling/web dev",
    "generate:ios:client": "node tooling/generate-ios-client.mjs",
    "lint:web": "pnpm --filter @keepling/web lint",
    "package:desktop": "pnpm --dir apps/desktop package",
    "smoke:desktop:packaged": "pnpm --dir apps/desktop smoke:packaged",
    "stack:local": "./tooling/run-local-stack.sh --start",
    "test:changed": "node tooling/select-tests.mjs",
    "test:desktop": "pnpm --dir apps/desktop test",
    "test:desktop:changed": "node tooling/test-changed.mjs",
    "test:desktop:e2e": "pnpm --dir apps/desktop test:e2e",
    "test:desktop:ipc": "pnpm --dir apps/desktop test:ipc",
    "test:phase-1": "./tooling/test-phase-1.sh --run",
    "tokens:swift": "node tooling/emit-swift-tokens.mjs",
    "typecheck:desktop": "pnpm --dir apps/desktop typecheck",
    "typecheck:web": "pnpm --filter @keepling/web typecheck",
    "verify:cross-adapter": "node tooling/verify-cross-adapter-phase.mjs",
    "verify:desktop:real-stack": "node tooling/verify-real-stack-desktop.mjs",
    "verify:desktop:reproducible": "node tooling/verify-package-reproducibility.mjs",
    "verify:ios:device": "node tooling/verify-ios-phase.mjs --lane device",
    "verify:ios:phase": "node tooling/verify-ios-phase.mjs",
    "verify:ios:real-stack": "node tooling/verify-real-stack-ios.mjs",
    "verify:ios:server-driven": "node tooling/verify-ios-phase.mjs --lane server-driven-sim",
    "verify:ios:server-driven:device": "node tooling/verify-ios-phase.mjs --lane server-driven-device",
    "verify:mcp:model": "node --env-file-if-exists=.env.local --env-file-if-exists=.env tooling/verify-mcp-phase.mjs --lane representative-model",
    "verify:mcp:phase": "pnpm run verify:mcp:selftest && node --env-file-if-exists=.env.local --env-file-if-exists=.env tooling/verify-mcp-phase.mjs",
    "verify:mcp:selftest": "node --test tooling/mcp-gate-selftest.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
